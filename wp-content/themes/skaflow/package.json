{
  "name": "skaflow",
  "version": "1.0.1",
  "description": "Skaflow Theme Boilerplate with Namespace and Gutenberg Block support",
  "author": "AtakiDev <developers@ataki.dev>",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "boilerplate",
    "gutenberg",
    "block"
  ],
  "homepage": "https://github.com/atakidevelopers/skaflow",
  "repository": {
    "type": "git",
    "directory": "wp-content/themes/skaflow",
    "branch": "main"
  },
  "bugs": {
    "url": "https://github.com/atakidevelopers/skaflow/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "npm": ">=10"
  },
  "files": [
    "*"
  ],
  "main": "build/index.js",
  "dependencies": {
    "@wordpress/block-editor": "^17.1.0",
    "@wordpress/blocks": "^16.0.0",
    "@wordpress/components": "^40.1.0",
    "@wordpress/compose": "^8.8.0",
    "@wordpress/data": "^10.55.0",
    "@wordpress/element": "^8.7.0",
    "@wordpress/hooks": "^4.55.0",
    "@wordpress/i18n": "^6.28.0",
    "lucide": "^1.26.0",
    "lucide-static": "^1.26.0",
    "swiper": "14.2.0"
  },
  "devDependencies": {
    "@wordpress/prettier-config": "^4.55.0",
    "@wordpress/scripts": "^35.0.0",
    "@wordpress/stylelint-config": "^25.0.0",
    "@wp-blocks/make-pot": "^1.6.6",
    "browser-sync": "^3.0.4",
    "dotenv": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "stylelint-scss": "^7.2.0",
    "subset-font": "^2.7.0"
  },
  "prettier": "@wordpress/prettier-config",
  "scripts": {
    "postinstall": "bash tools/check-hooks.sh",
    "start:assets": "wp-scripts start src/index.js src/public.js src/my-account.js src/checkout.js src/cart.js",
    "start:blocks": "wp-scripts start --webpack-src-dir=src-jsx-blocks --output-path=build-jsx-blocks --webpack-copy-php --blocks-manifest",
    "start": "npm-run-all --parallel start:assets start:blocks",
    "build:assets": "wp-scripts build src/index.js src/public.js src/my-account.js src/checkout.js src/cart.js",
    "build:blocks": "wp-scripts build --webpack-src-dir=src-jsx-blocks --output-path=build-jsx-blocks --webpack-copy-php --blocks-manifest",
    "build:icons": "node tools/generate-icon-surfaces.mjs",
    "build:makepot": "make-pot ./ ./languages --slug skaflow --domain theme",
    "build": "npm run build:assets && npm run build:blocks",
    "format": "wp-scripts format src src-jsx-blocks",
    "format:src": "wp-scripts format ./src",
    "format:js": "wp-scripts format-js src/",
    "lint:style": "wp-scripts lint-style \"src/sass/**/*.scss\" \"src/sass-admin/**/*.scss\" \"src-jsx-blocks/**/*.scss\" style.css",
    "lint:js": "wp-scripts lint-js src src-jsx-blocks tools config-dev",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "lint:md:docs": "wp-scripts lint-md-docs",
    "packages-update": "wp-scripts packages-update",
    "check-licenses": "wp-scripts check-licenses --prod --gpl2 --ignore=abab",
    "create-zip": "wp-scripts plugin-zip",
    "sync": "browser-sync start --config \"config-dev/browser-sync.js\"",
    "dev": "npm-run-all --parallel sync start:assets start:blocks"
  }
}
