# Release manifest for `npm run create-zip` (wp-scripts plugin-zip).
#
# npm-packlist reads THIS file and ignores .gitignore entirely when both exist.
# An exclusion added only to .gitignore will still ship. Keep the vendor/ split
# below in sync with .gitignore, which expresses the same rule for Git-based
# hosts that deploy the committed tree instead of the zip.

# --- Runtime dependencies: MUST ship -----------------------------------------
# vendor/autoload.php, vendor/composer/ and vendor/tgmpa/ are deliberately
# absent from this file. The theme fatals in includes/init.php without them.

# --- Dev-only Composer packages: never ship ----------------------------------
vendor/bin/
vendor/dealerdirect/
vendor/phpcsstandards/
vendor/squizlabs/
vendor/wp-coding-standards/
vendor/tgmpa/tgm-plugin-activation/plugins/tgm-example-plugin.zip

# --- Source that is compiled before release ----------------------------------
# build/ and build-jsx-blocks/ are the shipped output. src-acf-blocks/ has no
# build step and must ship.
src/
src-jsx-blocks/
node_modules/
package-lock.json
composer.lock

# --- Dev tooling and config --------------------------------------------------
bin/
tools/
config-dev/
phpcs.xml.dist
.phpcs-cache
.eslintrc.js
.stylelintrc.js
.prettierignore
.gitignore
.npmignore
.npmrc
.nvmrc

# README.md, package.json and LICENSE cannot be excluded — npm-packlist always
# keeps them regardless of ignore rules. Do not add them here; the rule silently
# does nothing.

# --- Release artefacts -------------------------------------------------------
skaflow.zip
skaflow-*.zip

# --- WordPress install leftovers, logs, editor cruft -------------------------
*.log
/.htaccess
/license.txt
/readme.html
/sitemap.xml
/sitemap.xml.gz
.idea/
.vscode/
.DS_Store
Thumbs.db
