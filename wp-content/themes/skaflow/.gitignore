# Menu-seeder output. Snapshots hold live term and menu-item IDs, so they are
# environment-specific and must never be committed. bin/backup-primary-nav-menu.php
# recreates this directory on demand.
bin/backups/
vendor/tgmpa/tgm-plugin-activation/plugins/tgm-example-plugin.zip

# Both lockfiles are deliberately tracked, and neither ships (.npmignore
# excludes them from the release zip). composer.lock pins tgmpa for production.
# package-lock.json pins the toolchain behind two things the gate treats as
# exact: build/ is compared byte-for-byte against HEAD, and the eslint and
# stylelint rule sets arrive through caret-ranged @wordpress/scripts. Unpinned,
# two developers can enforce different rules and each rebuild what the other
# committed, so the freshness check fails for reasons neither of them caused.

# WPCS / PHPCS (composer require-dev). Keep TGMPA in vendor/ for production zips.
# Install locally: ddev composer -d wp-content/themes/skaflow install
vendor/bin/
vendor/dealerdirect/
vendor/phpcsstandards/
vendor/squizlabs/
vendor/wp-coding-standards/
.phpcs-cache
