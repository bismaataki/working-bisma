	"styles": {
		"blocks": {
			"core/code": {
				"border": {
					"color": "var(--wp--preset--color--outline)",
					"radius": "4px",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--heading)"
				},
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--small)",
						"left": "var(--wp--preset--spacing--small)",
						"right": "var(--wp--preset--spacing--small)",
						"top": "var(--wp--preset--spacing--small)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--monospace)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0",
					"lineHeight": "1.6"
				}
			},
			"core/preformatted": {
				"border": {
					"color": "var(--wp--preset--color--outline)",
					"radius": "4px",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--heading)"
				},
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--small)",
						"left": "var(--wp--preset--spacing--small)",
						"right": "var(--wp--preset--spacing--small)",
						"top": "var(--wp--preset--spacing--small)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--monospace)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0",
					"lineHeight": "1.6"
				}
			},
			"core/quote": {
				"border": {
					"color": "var(--wp--preset--color--outline)",
					"style": "solid",
					"width": "0 0 0 2px"
				},
				"elements": {
					"cite": {
						"color": {
							"text": "var(--wp--preset--color--neutral)"
						},
						"typography": {
							"fontSize": "var(--wp--preset--font-size--small)",
							"fontStyle": "normal",
							"fontWeight": "var(--wp--custom--font-weight--regular)"
						}
					}
				},
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--x-small)",
					"margin": {
						"left": "0",
						"right": "0"
					},
					"padding": {
						"bottom": "var(--wp--preset--spacing--x-small)",
						"left": "var(--wp--preset--spacing--small)",
						"right": "var(--wp--preset--spacing--small)",
						"top": "var(--wp--preset--spacing--x-small)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "var(--wp--custom--font-weight--regular)",
					"lineHeight": "var(--wp--custom--line-height--large)"
				},
				"css": "&.has-text-align-right { border-width: 0 2px 0 0; } &.has-text-align-center { border-width: 0; padding-inline: 0; }",
				"variations": {
					"plain": {
						"border": {
							"color": "transparent",
							"style": "none",
							"width": "0"
						},
						"spacing": {
							"padding": {
								"bottom": "0",
								"left": "0",
								"right": "0",
								"top": "0"
							}
						}
					}
				}
			},
			"core/pullquote": {
				"elements": {
					"cite": {
						"color": {
							"text": "var(--wp--preset--color--neutral)"
						},
						"typography": {
							"fontSize": "var(--wp--preset--font-size--small)",
							"fontStyle": "normal"
						}
					}
				},
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--small)",
						"top": "var(--wp--preset--spacing--small)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "var(--wp--custom--font-weight--regular)",
					"lineHeight": "1.2"
				}
			},
			"core/verse": {
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--x-small)",
						"left": "0",
						"right": "0",
						"top": "var(--wp--preset--spacing--x-small)"
					}
				},
				"typography": {
					"fontStyle": "italic",
					"lineHeight": "var(--wp--custom--line-height--large)"
				}
			},
			"core/list": {
				"css": "& li { margin-top: 0.5rem; }"
			},
			"core/table": {
				"border": {
					"color": "var(--wp--preset--color--outline)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--small)"
				}
			},
			"core/group": {
				
			},
			"core/navigation": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--small)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "var(--wp--custom--font-weight--regular)",
					"letterSpacing": "0.25px",
					"lineHeight": "var(--wp--custom--line-height--large)"
				}
			},
			"core/post-author-name": {
				"color": {
					"text": "var(--wp--preset--color--heading)"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"right": "0",
						"bottom": "0",
						"left": "0"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "var(--wp--custom--font-weight--semi-bold)",
					"letterSpacing": "0.04em",
					"textTransform": "uppercase"
				}
			},
			"core/post-content": {
				"spacing": {
					"padding": {
						"left": "var(--wp--style--root--padding-left)",
