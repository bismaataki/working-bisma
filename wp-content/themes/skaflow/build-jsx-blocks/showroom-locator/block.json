{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "skaflow/showroom-locator",
  "version": "1.0.0",
  "title": "Showroom Locator",
  "category": "widgets",
  "description": "Interactive showroom selector with location filters, details card, and map markers.",
  "keywords": [
    "showroom",
    "location",
    "map",
    "store",
    "branch"
  ],
  "textdomain": "skaflow",
  "icon": "location-alt",
  "attributes": {
    "showCta": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "inserter": true,
    "reusable": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}