{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "skaflow/showroom-status-bar",
  "version": "1.0.0",
  "title": "Showroom Status Bar",
  "category": "widgets",
  "description": "Opening status, address, and phone pills for a single showroom page.",
  "keywords": [
    "showroom",
    "hours",
    "status",
    "address",
    "phone"
  ],
  "textdomain": "skaflow",
  "icon": "info",
  "usesContext": [
    "postId",
    "postType"
  ],
  "supports": {
    "html": false,
    "reusable": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}