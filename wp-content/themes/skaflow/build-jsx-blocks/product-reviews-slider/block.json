{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "skaflow/product-reviews-slider",
  "version": "1.0.0",
  "title": "Product Reviews Slider",
  "category": "woocommerce",
  "description": "Marketing Swiper carousel of verified WooCommerce product reviews.",
  "keywords": [
    "woocommerce",
    "review",
    "testimonial",
    "swiper",
    "carousel"
  ],
  "textdomain": "skaflow",
  "icon": "slides",
  "attributes": {
    "reviewsToShow": {
      "type": "number",
      "default": 8
    },
    "orderBy": {
      "type": "string",
      "default": "rating",
      "enum": [
        "rating",
        "date"
      ]
    },
    "productId": {
      "type": "number",
      "default": 0
    },
    "categoryIds": {
      "type": "array",
      "default": []
    },
    "verifiedOnly": {
      "type": "boolean",
      "default": true
    },
    "showSummary": {
      "type": "boolean",
      "default": true
    },
    "showReviewRating": {
      "type": "boolean",
      "default": true
    },
    "showReviewerName": {
      "type": "boolean",
      "default": true
    },
    "showReviewContent": {
      "type": "boolean",
      "default": true
    },
    "showProductName": {
      "type": "boolean",
      "default": true
    },
    "showReviewDate": {
      "type": "boolean",
      "default": false
    },
    "showArrowsDesktop": {
      "type": "boolean",
      "default": true
    },
    "showArrowsMobile": {
      "type": "boolean",
      "default": false
    },
    "showProgressBar": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "inserter": true,
    "reusable": true,
    "lock": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}