{
  "name": "ataki/skaflow",
  "description": "Theme Boilerplate with Namespace and Gutenberg Block support",
  "type": "wordpress-theme",
  "license": "GPL2",
  "authors": [
    {
      "name": "AtakiDev",
      "email": "developers@ataki.dev"
    }
  ],
  "require": {
    "tgmpa/tgm-plugin-activation": "^2.6.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcsstandards/phpcsextra": "^1.5",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "autoload": {
    "classmap": [
      "lib",
      "public"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "phpcs-set-paths": "php -d auto_prepend_file=tools/phpcs-wp-stubs.php vendor/squizlabs/php_codesniffer/bin/phpcs --config-set installed_paths ../../wp-coding-standards/wpcs,../../phpcsstandards/phpcsextra,../../phpcsstandards/phpcsutils",
    "post-install-cmd": [
      "@phpcs-set-paths"
    ],
    "post-update-cmd": [
      "@phpcs-set-paths"
    ],
    "phpcs": "php -d auto_prepend_file=tools/phpcs-wp-stubs.php vendor/squizlabs/php_codesniffer/bin/phpcs",
    "phpcbf": "php -d auto_prepend_file=tools/phpcs-wp-stubs.php vendor/squizlabs/php_codesniffer/bin/phpcbf"
  }
}
