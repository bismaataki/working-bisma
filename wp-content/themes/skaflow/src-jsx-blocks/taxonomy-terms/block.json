{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "skaflow/taxonomy-terms",
	"version": "1.0.0",
	"title": "Taxonomy Terms",
	"category": "theme",
	"description": "Display assigned taxonomy terms for the current post in the loop.",
	"keywords": ["taxonomy", "terms", "category", "tag", "label"],
	"textdomain": "skaflow",
	"icon": "tag",
	"usesContext": ["postId", "postType", "queryId"],
	"attributes": {
		"taxonomy": {
			"type": "string",
			"default": "category"
		},
		"limit": {
			"type": "number"
		},
		"isLink": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"inserter": true,
		"reusable": true,
		"anchor": true,
		"align": ["wide", "full"],
		"spacing": {
			"margin": true,
			"blockGap": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
