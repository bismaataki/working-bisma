{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "happywood/delivery-estimate",
	"version": "1.0.0",
	"title": "Delivery Estimate",
	"category": "woocommerce",
	"description": "Postcode and quantity lookup that returns a freight price or a quote fallback for the current product.",
	"keywords": ["delivery", "shipping", "freight", "postcode", "estimate"],
	"textdomain": "happywood",
	"icon": "location",
	"usesContext": ["postId"],
	"supports": {
		"html": false,
		"anchor": true,
		"inserter": true,
		"reusable": false,
		"lock": false,
		"multiple": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
