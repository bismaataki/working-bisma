{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "happywood/post-card",
  "version": "1.0.0",
  "title": "Post Card",
  "category": "widgets",
  "description": "Canonical Happywood blog post card for the current post in a Query Loop.",
  "keywords": [
    "post",
    "blog",
    "article",
    "card"
  ],
  "textdomain": "happywood",
  "icon": "admin-post",
  "ancestor": [
    "core/post-template"
  ],
  "usesContext": [
    "postId",
    "postType",
    "query",
    "queryId"
  ],
  "attributes": {
    "titleLevel": {
      "type": "number",
      "default": 3
    },
    "dateFormat": {
      "type": "string",
      "default": "F j, Y"
    },
    "showImage": {
      "type": "boolean",
      "default": true
    },
    "showCategory": {
      "type": "boolean",
      "default": true
    },
    "showSingleCategoryTerm": {
      "type": "boolean",
      "default": true
    },
    "showReadingTime": {
      "type": "boolean",
      "default": true
    },
    "showExcerpt": {
      "type": "boolean",
      "default": true
    },
    "showAuthor": {
      "type": "boolean",
      "default": true
    },
    "showDate": {
      "type": "boolean",
      "default": true
    },
    "hasBorder": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "inserter": true,
    "reusable": false,
    "lock": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}