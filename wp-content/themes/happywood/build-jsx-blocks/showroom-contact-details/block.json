{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "happywood/showroom-contact-details",
  "version": "1.0.0",
  "title": "Showroom Contact Details",
  "category": "widgets",
  "description": "Showroom selector with contact details card for contact forms and landing pages.",
  "keywords": [
    "showroom",
    "contact",
    "location",
    "store",
    "branch"
  ],
  "textdomain": "happywood",
  "icon": "phone",
  "attributes": {
    "showrooms": {
      "type": "array",
      "default": []
    },
    "ctaType": {
      "type": "string",
      "default": "directions",
      "enum": [
        "directions",
        "learn-more"
      ]
    },
    "showImage": {
      "type": "boolean",
      "default": false
    },
    "showAddress": {
      "type": "boolean",
      "default": true
    },
    "showTime": {
      "type": "boolean",
      "default": true
    },
    "showContact": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "inserter": true,
    "reusable": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}